<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_info_zone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_title"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_network_band"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="102dp"
                android:text="@string/widget_default_band"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/widget_bullet"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_dbm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_default_dbm"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/widget_bullet"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_ping_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_default_ping"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_btn_refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/widget_refresh_desc"
        android:padding="6dp"
        android:src="@drawable/ic_refresh_small" />

    <TextView
        android:id="@+id/widget_btn_toggle"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_widget_pill_inactive"
        android:gravity="center"
        android:minWidth="74dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_start_btn"
        android:textColor="#F8FAFC"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
